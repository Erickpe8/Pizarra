APP_PORT=8001
VITE_PORT=5173
APP_URL=http://localhost:8001
APP_NAME=Pizarra

DB_DATABASE=pizarra
DB_USERNAME=pizarra
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6380

# Arranque liviano (sin Vite):
#   docker compose --env-file .env.docker up -d --build
#
# Con hot-reload:
#   docker compose --env-file .env.docker --profile frontend up -d
#
# Compilar assets una vez:
#   docker compose --env-file .env.docker --profile frontend run --rm node sh -c "npm ci && npm run build"
